[Unit]
Description=PoolPayCoin pool: public API (127.0.0.1:8149)
After=ppc-pool-redis.service poolpay-node.service
Requires=ppc-pool-redis.service
[Service]
Type=simple
User=ppcpool
WorkingDirectory=/opt/poolpay-nodejs-pool
ExecStart=/usr/bin/node /opt/poolpay-nodejs-pool/init.js -module=api
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
