[Unit]
Description=PoolPayCoin pool: payment processor (sendmany from the pool wallet; emergency brake: deployment/pause-payments.sh)
After=ppc-pool-redis.service poolpay-node.service
Requires=ppc-pool-redis.service
[Service]
Type=simple
User=ppcpool
WorkingDirectory=/opt/poolpay-nodejs-pool
ExecStart=/usr/bin/node /opt/poolpay-nodejs-pool/init.js -module=payments
Restart=always
RestartSec=15
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
