[Unit]
Description=PoolPayCoin pool: stratum server (miners, share checking with the rxhash helper, block submission)
After=ppc-pool-redis.service poolpay-node.service
Requires=ppc-pool-redis.service
[Service]
Type=simple
User=ppcpool
WorkingDirectory=/opt/poolpay-nodejs-pool
ExecStart=/usr/bin/node /opt/poolpay-nodejs-pool/init.js -module=pool
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
# ports below 1024 need this:
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
