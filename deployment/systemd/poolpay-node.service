[Unit]
Description=PoolPayCoin node (poolpaycoind): the chain, the block templates and the pool wallet
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ppcpool
# poolpay.conf: chain=poolpay, server=1, rpcuser/rpcpassword, rpcbind=127.0.0.1, rpcport=8342, fallbackfee=0.0001, addnode=<peers>, see docs/INSTALL.md
ExecStart=/opt/poolpaycoin/bin/poolpaycoind -datadir=/opt/poolpaycoin/data -conf=/opt/poolpaycoin/data/poolpay.conf -printtoconsole
Restart=on-failure
RestartSec=30
LimitNOFILE=65536
TimeoutStopSec=180
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
