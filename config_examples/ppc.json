{
  "poolHost": "pool.example.com",
  "coin": "PoolPayCoin",
  "symbol": "PPC",
  "coinUnits": 100000000,
  "coinDecimalPlaces": 8,
  "coinDifficultyTarget": 120,
  "addressPrefix": "ppc",
  "blockchainExplorer": "https://explorer.pool-pay.com/block/{id}",
  "transactionExplorer": "https://explorer.pool-pay.com/tx/{id}",
  "logging": {
    "files": {
      "level": "info",
      "directory": "logs",
      "flushInterval": 5
    },
    "console": {
      "level": "info",
      "colors": true
    }
  },
  "poolServer": {
    "enabled": true,
    "mergedMining": false,
    "clusterForks": 1,
    "minerTimeout": 240,
    "sslCert": "/opt/ppc-nodejs-pool/ssl/fullchain.pem",
    "sslKey": "/opt/ppc-nodejs-pool/ssl/privkey.pem",
    "sslCA": "./chain.pem",
    "ports": [
      {
        "port": 5400,
        "desc": "PPC stratum (plain TCP, difficulty adjusts to your hashrate)"
      },
      {
        "port": 5401,
        "desc": "PPC stratum over TLS (encrypted)",
        "tls": true
      },
      {
        "port": 5402,
        "desc": "PPC stratum over TLS (alternative port)",
        "tls": true
      },
      {
        "port": 5403,
        "desc": "PPC stratum over TLS (alternative port)",
        "tls": true
      }
    ],
    "banning": {
      "enabled": true,
      "time": 600,
      "invalidPercent": 25,
      "checkThreshold": 30
    },
    "slushMining": {
      "enabled": true,
      "weight": 86400
    },
    "bindIp": "0.0.0.0",
    "allowIPs": [],
    "maxConnectionsPerIp": 100,
    "maxUnauthenticatedPerIp": 10,
    "loginTimeout": 20,
    "maxConnections": 3000,
    "varDiff": {
      "startDiff": 5000,
      "minDiff": 1000,
      "maxDiff": 5000000,
      "targetTime": 20,
      "retargetTime": 60,
      "variancePercent": 30,
      "maxJump": 100
    },
    "jobRefresh": 1000,
    "poolAddress": "ppc1qYourPoolWalletAddress...",
    "templateRefresh": 30,
    "coinbaseTag": "/mypool/"
  },
  "payments": {
    "enabled": true,
    "interval": 600,
    "minPayment": 100000000,
    "maxTransactionAmount": 1000000000000,
    "maxPaymentsPerRound": 50,
    "minConfirmations": 6,
    "pendingTimeoutHours": 48,
    "reserve": 1000000,
    "minerPayFee": true,
    "dryRun": true,
    "onlyAccounts": [],
    "stopFile": "/opt/ppc-nodejs-pool/STOP_PAYMENTS"
  },
  "blockUnlocker": {
    "enabled": true,
    "interval": 60,
    "depth": 110,
    "poolFee": 1,
    "networkFee": 0,
    "donations": {
      "ppc1qnsl3wsepdfjt9xvctsglj3q0kj27ce8w7653a0": 1
    }
  },
  "api": {
    "enabled": true,
    "hashrateWindow": 600,
    "updateInterval": 5,
    "bindIp": "127.0.0.1",
    "port": 8149,
    "blocks": 30,
    "payments": 30,
    "password": "CHANGE_ME_API_PASSWORD",
    "ssl": false,
    "sslPort": 8119,
    "sslCert": "./cert.pem",
    "sslKey": "./privkey.pem",
    "sslCA": "./chain.pem",
    "trustProxyIP": true
  },
  "redis": {
    "host": "127.0.0.1",
    "port": 6406,
    "auth": "CHANGE_ME_REDIS_PASSWORD",
    "db": 0,
    "cleanupInterval": 15
  },
  "prices": {
    "source": "tradeogre",
    "currency": "USD"
  },
  "charts": {
    "pool": {
      "hashrate": {
        "enabled": true,
        "updateInterval": 60,
        "stepInterval": 1800,
        "maximumPeriod": 86400
      },
      "miners": {
        "enabled": true,
        "updateInterval": 60,
        "stepInterval": 1800,
        "maximumPeriod": 86400
      },
      "workers": {
        "enabled": true,
        "updateInterval": 60,
        "stepInterval": 1800,
        "maximumPeriod": 86400
      },
      "difficulty": {
        "enabled": true,
        "updateInterval": 1800,
        "stepInterval": 10800,
        "maximumPeriod": 604800
      },
      "price": {
        "enabled": true,
        "updateInterval": 1800,
        "stepInterval": 10800,
        "maximumPeriod": 604800
      },
      "profit": {
        "enabled": true,
        "updateInterval": 1800,
        "stepInterval": 10800,
        "maximumPeriod": 604800
      }
    },
    "user": {
      "hashrate": {
        "enabled": true,
        "updateInterval": 180,
        "stepInterval": 1800,
        "maximumPeriod": 86400
      },
      "worker_hashrate": {
        "enabled": true,
        "updateInterval": 60,
        "stepInterval": 60,
        "maximumPeriod": 86400
      },
      "payments": {
        "enabled": true
      }
    },
    "blocks": {
      "enabled": true,
      "days": 30
    }
  },
  "node": {
    "host": "127.0.0.1",
    "port": 8351,
    "user": "poolpaypool",
    "passwordFile": "/opt/poolpaycoin/data/rpc.pass"
  },
  "hasher": {
    "path": "/opt/ppc-nodejs-pool/hasher/rxhash",
    "args": [
      "--poolpay"
    ],
    "threads": 2,
    "light": true
  }
}
